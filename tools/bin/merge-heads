#!/usr/bin/env python3
r"""
merge-heads: Build mpHeadsAndBodiesTable.json and .dat from vanilla source + mod modconfig.txt files.

Usage:
    merge-heads --pd-src <pd-modloader-src>
    merge-heads --pd-src . --mod-order mod_fojo,mod_gex

    --pd-src     pd-modloader source root (default: cwd)
    --filetable  merged filetable.json    (default: <pd-src>/filetable.json)
    --mods-root  mods directory           (default: <pd-src>/mods)
    --mod-order  comma-separated mod list (default: auto-detect from mods-root)
    --output     output directory         (default: cwd)

Produces:
    mpHeadsAndBodiesTable.json  (intermediate, human-readable)
    mpHeadsAndBodiesTable.dat   (binary, loaded by engine)
"""

import argparse
import json
import os
import re
import struct
import sys

# ─── Constants ──────────────────────────────────────────────────────────────

MAGIC = b"MPHB"
VERSION = 1

# ─── Step 1: Parse C #define constants from header files ────────────────────

def parse_defines(filepath, prefix_filter=None):
    """Parse #define NAME VALUE lines from a C header. Returns dict name->int."""
    defines = {}
    pattern = re.compile(r'^\s*#define\s+(\w+)\s+([-]?0x[0-9a-fA-F]+|[-]?\d+)')
    with open(filepath, 'r') as f:
        for line in f:
            m = pattern.match(line)
            if m:
                name = m.group(1)
                if prefix_filter and not any(name.startswith(p) for p in prefix_filter):
                    continue
                val = m.group(2)
                defines[name] = int(val, 0)
    return defines


def parse_generated_lang_enums(build_dir):
    """Parse generated lang enum headers to get L_OPTIONS_xxx and L_MPWEAPONS_xxx values."""
    lang_values = {}
    for subdir in ["ntsc-final"]:
        lang_dir = os.path.join(build_dir, "src", "generated", subdir, "lang")
        if not os.path.isdir(lang_dir):
            continue
        for fname in os.listdir(lang_dir):
            if not fname.endswith('.h'):
                continue
            fpath = os.path.join(lang_dir, fname)
            base_val = None
            counter = 0
            enum_re = re.compile(r'^\s+(\w+)\s*(?:=\s*(0x[0-9a-fA-F]+|\d+))?\s*,?\s*$')
            with open(fpath, 'r') as f:
                in_enum = False
                for line in f:
                    if 'enum ' in line:
                        in_enum = True
                        continue
                    if in_enum and line.strip().startswith('}'):
                        in_enum = False
                        continue
                    if not in_enum:
                        continue
                    m = enum_re.match(line)
                    if m:
                        name = m.group(1)
                        if m.group(2):
                            base_val = int(m.group(2), 0)
                            counter = base_val
                        lang_values[name] = counter
                        counter += 1
    return lang_values

# ─── Step 2: Parse vanilla g_HeadsAndBodiesOriginal from robot.c ────────────

def parse_vanilla_heads_and_bodies(robot_c_path, file_defines, const_defines):
    """Parse g_HeadsAndBodiesOriginal[] from robot.c. Returns list of dicts."""
    entries = []
    in_array = False
    # Regex for entry like: { /*0x0000*/ 1, 0, 0, HEADBODYTYPE_DEFAULT, 167, FILE_CDJBOND, 1, 1.0446, 0, FILE_GHAND_DDSECURITY },
    entry_re = re.compile(
        r'\{\s*/\*0x([0-9a-fA-F]+)\*/\s*'
        r'(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*,\s*(\w+)\s*,\s*'
        r'(\d+)\s*,\s*(\w+)\s*,\s*'
        r'([0-9.e+-]+)\s*,\s*([0-9.e+-]+)\s*,\s*'
        r'(\d+)\s*,\s*(\w+)\s*'
        r'(?:,\s*(\d+))?\s*\}'  # optional yoffset field
    )
    skip_else = False

    with open(robot_c_path, 'r') as f:
        for line in f:
            stripped = line.strip()
            if 'g_HeadsAndBodiesOriginal[]' in line:
                in_array = True
                continue
            if in_array and stripped.startswith('};'):
                break
            if not in_array:
                continue

            # Handle #if VERSION >= VERSION_NTSC_1_0 blocks — use the NTSC_1_0 path
            if stripped.startswith('#if VERSION >= VERSION_NTSC_1_0'):
                skip_else = False
                continue
            if stripped.startswith('#if VERSION') and 'NTSC_1_0' not in stripped:
                skip_else = False
                continue
            if stripped.startswith('#else'):
                skip_else = True
                continue
            if stripped.startswith('#endif'):
                skip_else = False
                continue
            if skip_else:
                continue

            m = entry_re.search(line)
            if m:
                idx = int(m.group(1), 16)
                ismale = int(m.group(2))
                hasownhead = int(m.group(3))
                canvaryheight = int(m.group(4))
                type_name = m.group(5)
                height = int(m.group(6))
                filenum_name = m.group(7)
                scale = float(m.group(8))
                animscale = float(m.group(9))
                yoffset_field = int(m.group(10))
                hand_name = m.group(11)
                # yoffset is the field after handfilenum if present
                # In the source, the struct has yoffset as a separate field added by the port
                yoffset = int(m.group(12)) if m.group(12) else 0

                type_val = const_defines.get(type_name, 0)
                filenum_val = file_defines.get(filenum_name, 0) if filenum_name != '0' else 0
                hand_val = file_defines.get(hand_name, 0) if hand_name != '0' else 0

                entries.append({
                    "index": idx,
                    "ismale": ismale,
                    "hasownhead": hasownhead,
                    "canvaryheight": canvaryheight,
                    "type": type_val,
                    "height": height,
                    "filenum": filenum_val,
                    "scale": scale,
                    "animscale": animscale,
                    "handfilenum": hand_val,
                    "yoffset": yoffset,
                })

    return entries


# ─── Step 3: Parse vanilla g_MpHeadsOriginal from mplayer.c ────────────────

def parse_vanilla_mp_heads(mplayer_c_path, const_defines):
    """Parse g_MpHeadsOriginal[] from mplayer.c. Returns list of dicts."""
    entries = []
    in_array = False
    entry_re = re.compile(
        r'\{\s*/\*0x([0-9a-fA-F]+)\*/\s*(\w+)\s*,\s*(\w+)\s*\}'
    )
    skip_else = False

    with open(mplayer_c_path, 'r') as f:
        for line in f:
            stripped = line.strip()
            if 'g_MpHeadsOriginal[]' in line:
                in_array = True
                continue
            if in_array and stripped.startswith('};'):
                break
            if not in_array:
                continue

            if stripped.startswith('#if VERSION != VERSION_JPN_FINAL'):
                skip_else = False
                continue
            if stripped.startswith('#if VERSION'):
                skip_else = False
                continue
            if stripped.startswith('#else'):
                skip_else = True
                continue
            if stripped.startswith('#endif'):
                skip_else = False
                continue
            if skip_else:
                continue

            m = entry_re.search(line)
            if m:
                slot = int(m.group(1), 16)
                headnum_name = m.group(2)
                feature_name = m.group(3)
                headnum = const_defines.get(headnum_name, 0)
                feature = const_defines.get(feature_name, 0) if feature_name != '0' else 0
                entries.append({
                    "slot": slot,
                    "headnum": headnum,
                    "requirefeature": feature,
                })

    return entries


# ─── Step 4: Parse vanilla g_MpBodiesOriginal from mplayer.c ───────────────

def parse_vanilla_mp_bodies(mplayer_c_path, const_defines, lang_defines):
    """Parse g_MpBodiesOriginal[] from mplayer.c. Returns list of dicts."""
    entries = []
    in_array = False
    entry_re = re.compile(
        r'/\*0x([0-9a-fA-F]+)\*/\s*\{\s*(\w+)\s*,\s*(\w+)\s*,\s*(\w+)\s*,\s*(\w+)\s*\}'
    )

    with open(mplayer_c_path, 'r') as f:
        for line in f:
            stripped = line.strip()
            if 'g_MpBodiesOriginal[]' in line:
                in_array = True
                continue
            if in_array and stripped.startswith('};'):
                break
            if not in_array:
                continue

            m = entry_re.search(line)
            if m:
                slot = int(m.group(1), 16)
                bodynum_name = m.group(2)
                name_name = m.group(3)
                headnum_name = m.group(4)
                feature_name = m.group(5)

                bodynum = const_defines.get(bodynum_name, 0)

                # name is a lang ID
                all_defs = {**const_defines, **lang_defines}
                name_val = all_defs.get(name_name, 0)

                # headnum: can be HEAD_xxx constant or literal 1000
                if headnum_name == '1000':
                    headnum = 1000
                else:
                    headnum = const_defines.get(headnum_name, 0)

                feature = const_defines.get(feature_name, 0) if feature_name != '0' else 0

                entries.append({
                    "slot": slot,
                    "bodynum": bodynum,
                    "name": name_val,
                    "headnum": headnum,
                    "requirefeature": feature,
                })

    return entries


# ─── Step 5: Parse vanilla head name → index mapping from mod.c ────────────

def parse_vanilla_head_names(mod_c_path):
    """Parse g_VanillaHeadNames[] from mod.c. Returns dict name->index."""
    names = {}
    in_array = False
    entry_re = re.compile(r'\{\s*"([^"]+)"\s*,\s*(\w+)\s*\}')

    with open(mod_c_path, 'r') as f:
        for line in f:
            if 'g_VanillaHeadNames' in line and '[' in line:
                in_array = True
                continue
            if in_array and '};' in line:
                break
            if not in_array:
                continue

            m = entry_re.search(line)
            if m:
                name = m.group(1)
                const_name = m.group(2)
                names[name] = const_name  # Will resolve later

    return names


# ─── Step 6: Load merged filetable.json ─────────────────────────────────────

def build_vanilla_filename_map(file_defines):
    """Build a case-insensitive filename -> ID map from FILE_* defines.

    FILE_GHAND_JOFROCK (0x052b) -> "Ghand_jofrockZ" -> 0x052b
    FILE_CDJBOND (0x0047) -> "CdjbondZ" -> 0x0047

    Convention: strip FILE_ prefix, mixed-case first letter, lowercase rest, append Z.
    We store both the derived name and a lowercased key for case-insensitive lookup.
    """
    name_map = {}
    for define_name, file_id in file_defines.items():
        if not define_name.startswith("FILE_"):
            continue
        raw = define_name[5:]  # strip FILE_

        # Split on underscores, reconstruct with mixed case
        parts = raw.split('_')
        if not parts:
            continue

        # First part: capitalize first letter, lowercase rest (C, G, U, etc.)
        # Remaining parts: all lowercase, joined with underscore
        filename = parts[0][0].upper() + parts[0][1:].lower()
        if len(parts) > 1:
            filename += '_' + '_'.join(p.lower() for p in parts[1:])
        filename += 'Z'

        name_map[filename.lower()] = file_id

    return name_map


def load_filetable(filetable_json_path, vanilla_file_map=None):
    """Load merged filetable.json and build name->id map.
    Optionally merge in vanilla_file_map (case-insensitive filename -> id).
    """
    name_to_id = {}

    # Start with vanilla FILE_ defines as fallback
    if vanilla_file_map:
        for lc_name, fid in vanilla_file_map.items():
            name_to_id[lc_name] = fid

    with open(filetable_json_path, 'r') as f:
        data = json.load(f)

    files = data.get("files", data) if isinstance(data, dict) else data
    for entry in files:
        name = entry.get("name")
        fid = entry.get("id")
        if fid is not None and isinstance(fid, str):
            fid = int(fid, 16)
        if name and fid is not None:
            # Mod filetable entries override vanilla by exact name (case-sensitive stored, case-insensitive key)
            name_to_id[name.lower()] = fid

    return name_to_id


# ─── Step 7: Parse modconfig.txt HeadsAndBodies blocks ─────────────────────

def parse_modconfig_heads_and_bodies(modconfig_path, filetable_names):
    """Parse HeadsAndBodies blocks from a modconfig.txt. Returns list of parsed entries."""
    entries = []

    with open(modconfig_path, 'r') as f:
        content = f.read()

    # Find all HeadsAndBodies { ... } blocks
    block_re = re.compile(r'HeadsAndBodies\s*\{([^}]*)\}', re.DOTALL)

    for block_match in block_re.finditer(content):
        block = block_match.group(1)
        entry = {
            "ismale": 0,
            "hasownhead": 0,
            "canvaryheight": 0,
            "type": 0,
            "height": 0,
            "filenum": 0,
            "scale": 1.0,
            "animscale": 1.0,
            "handfilenum": 0,
            "yoffset": 0,
            "name": None,
            "slotnum": -1,
            "bodyslotnum": -1,
            "bodyname": 0,
            "bodyheadnum": -1,
            "requirefeature": 0,
        }

        for line in block.splitlines():
            line = line.strip()
            if not line or line.startswith('#'):
                continue

            # Parse key value pairs
            kv_re = re.compile(r'(\w+)\s+(.+)')
            m = kv_re.match(line)
            if not m:
                continue

            key = m.group(1).lower()
            val = m.group(2).strip()

            if key == "name":
                entry["name"] = val.strip('"')
            elif key == "filenum":
                val_unquoted = val.strip('"')
                if val_unquoted.startswith('0x'):
                    entry["filenum"] = int(val_unquoted, 16)
                elif val_unquoted.isdigit():
                    entry["filenum"] = int(val_unquoted)
                else:
                    # String file name — resolve from filetable (case-insensitive)
                    fid = filetable_names.get(val_unquoted.lower())
                    if fid is not None:
                        entry["filenum"] = fid
                    else:
                        print(f"  Warning: filenum '{val_unquoted}' not found in filetable", file=sys.stderr)
                        entry["filenum"] = 0
            elif key == "handfilenum":
                val_unquoted = val.strip('"')
                if val_unquoted.startswith('0x'):
                    entry["handfilenum"] = int(val_unquoted, 16)
                elif val_unquoted.isdigit():
                    entry["handfilenum"] = int(val_unquoted)
                else:
                    fid = filetable_names.get(val_unquoted.lower())
                    if fid is not None:
                        entry["handfilenum"] = fid
                    else:
                        print(f"  Warning: handfilenum '{val_unquoted}' not found in filetable", file=sys.stderr)
                        entry["handfilenum"] = 0
            elif key == "ismale":
                entry["ismale"] = int(val)
            elif key == "hasownhead" or key == "unk00_01":
                # `unk00_01` is the legacy name; accept it for backward compatibility.
                entry["hasownhead"] = int(val)
            elif key == "canvaryheight":
                entry["canvaryheight"] = int(val)
            elif key == "type":
                entry["type"] = int(val, 0)
            elif key == "height":
                entry["height"] = int(val, 0)
            elif key == "scale":
                entry["scale"] = float(val)
            elif key == "animscale":
                entry["animscale"] = float(val)
            elif key == "yoffset":
                entry["yoffset"] = int(val, 0)
            elif key == "slotnum":
                entry["slotnum"] = int(val, 0)
            elif key == "bodyslotnum":
                entry["bodyslotnum"] = int(val, 0)
            elif key == "bodyname":
                entry["bodyname"] = int(val, 0)
            elif key == "bodyheadnum":
                entry["bodyheadnum"] = int(val, 0)
            elif key == "requirefeature":
                entry["requirefeature"] = int(val, 0)

        entries.append(entry)

    return entries


# ─── Step 8: Merge everything ──────────────────────────────────────────────

def merge_tables(vanilla_hab, vanilla_mp_heads, vanilla_mp_bodies,
                 vanilla_head_names, const_defines, mod_entries_by_mod,
                 filetable_names):
    """
    Merge vanilla tables with mod entries.
    Returns (headsAndBodies, mpHeads, mpBodies) as lists of dicts.
    """

    # Start with vanilla tables
    hab = list(vanilla_hab)  # copy
    mp_heads = list(vanilla_mp_heads)
    mp_bodies = list(vanilla_mp_bodies)

    # Resolve vanilla head names to indices
    name_to_index = {}
    for name, const_name in vanilla_head_names.items():
        idx = const_defines.get(const_name)
        if idx is not None:
            name_to_index[name] = idx

    next_hab_index = max(e["index"] for e in hab) + 1 if hab else 0
    next_mp_head_slot = max(e["slot"] for e in mp_heads) + 1 if mp_heads else 0
    # mp_bodies slots may be explicit, track max for reference
    next_mp_body_slot = max(e["slot"] for e in mp_bodies) + 1 if mp_bodies else 0

    # Build slot lookup for existing mp_heads and mp_bodies
    mp_head_slots = {e["slot"]: i for i, e in enumerate(mp_heads)}
    mp_body_slots = {e["slot"]: i for i, e in enumerate(mp_bodies)}

    for mod_name, mod_entries in mod_entries_by_mod.items():
        print(f"  Merging {len(mod_entries)} entries from {mod_name}...")

        for entry in mod_entries:
            name = entry.get("name")
            replace_index = -1

            # Check if this name replaces an existing entry
            if name:
                if name in name_to_index:
                    replace_index = name_to_index[name]

            # Build the headorbody record
            hab_entry = {
                "ismale": entry["ismale"],
                "hasownhead": entry["hasownhead"],
                "canvaryheight": entry["canvaryheight"],
                "type": entry["type"],
                "height": entry["height"],
                "filenum": entry["filenum"],
                "scale": entry["scale"],
                "animscale": entry["animscale"],
                "handfilenum": entry["handfilenum"],
                "yoffset": entry["yoffset"],
                "source": mod_name,
            }
            if name:
                hab_entry["name"] = name

            if replace_index >= 0:
                # Replace existing entry
                hab_entry["index"] = replace_index
                # Find and update in hab list
                for i, existing in enumerate(hab):
                    if existing["index"] == replace_index:
                        hab[i] = hab_entry
                        break
                hab_index = replace_index
                print(f"    Replaced index 0x{replace_index:04x} ({name})")
            else:
                # Append new entry
                hab_entry["index"] = next_hab_index
                hab.append(hab_entry)
                hab_index = next_hab_index
                next_hab_index += 1

                # Register name for future lookups within this merge
                if name:
                    name_to_index[name] = hab_index

                print(f"    Added index 0x{hab_index:04x} ({name or 'unnamed'})")

            # Head slot assignment
            slotnum = entry.get("slotnum", -1)
            bodyslotnum = entry.get("bodyslotnum", -1)

            if slotnum >= 0:
                # Explicit head slot
                mp_head_entry = {
                    "slot": slotnum,
                    "headnum": hab_index,
                    "requirefeature": entry.get("requirefeature", 0),
                    "source": mod_name,
                }
                if slotnum in mp_head_slots:
                    mp_heads[mp_head_slots[slotnum]] = mp_head_entry
                else:
                    mp_heads.append(mp_head_entry)
                    mp_head_slots[slotnum] = len(mp_heads) - 1
                if slotnum >= next_mp_head_slot:
                    next_mp_head_slot = slotnum + 1
            elif replace_index < 0 and bodyslotnum < 0:
                # Auto-append head slot for new head-only entries
                mp_head_entry = {
                    "slot": next_mp_head_slot,
                    "headnum": hab_index,
                    "requirefeature": entry.get("requirefeature", 0),
                    "source": mod_name,
                }
                mp_heads.append(mp_head_entry)
                mp_head_slots[next_mp_head_slot] = len(mp_heads) - 1
                next_mp_head_slot += 1

            # Body slot assignment — auto-assign sequential slots
            # bodyslotnum >= 0 is treated as a boolean signal ("this is a body"),
            # the actual slot number is assigned by merge-heads starting after vanilla.
            if bodyslotnum >= 0:
                assigned_slot = next_mp_body_slot
                mp_body_entry = {
                    "slot": assigned_slot,
                    "bodynum": hab_index,
                    "name": entry.get("bodyname", 0),
                    "headnum": entry.get("bodyheadnum", 1000),
                    "requirefeature": entry.get("requirefeature", 0),
                    "source": mod_name,
                }
                mp_bodies.append(mp_body_entry)
                mp_body_slots[assigned_slot] = len(mp_bodies) - 1
                next_mp_body_slot = assigned_slot + 1

    # Sort by slot/index for deterministic output
    hab.sort(key=lambda e: e["index"])
    mp_heads.sort(key=lambda e: e["slot"])
    mp_bodies.sort(key=lambda e: e["slot"])

    return hab, mp_heads, mp_bodies


# ─── Step 9: Write JSON ────────────────────────────────────────────────────

def fmt_hex(val, width=4):
    """Format an integer as hex string for JSON."""
    if val < 0:
        return f"-0x{(-val):0{width}x}"
    return f"0x{val:0{width}x}"


def write_json(hab, mp_heads, mp_bodies, output_path):
    """Write mpHeadsAndBodiesTable.json."""

    def hab_to_json(e):
        d = {
            "index": fmt_hex(e["index"], 4),
            "filenum": fmt_hex(e["filenum"], 4),
            "ismale": e["ismale"],
            "hasownhead": e["hasownhead"],
            "canvaryheight": e["canvaryheight"],
            "type": fmt_hex(e["type"], 2),
            "height": fmt_hex(e["height"], 2),
            "scale": e["scale"],
            "animscale": e["animscale"],
            "handfilenum": fmt_hex(e["handfilenum"], 4),
            "yoffset": e["yoffset"],
        }
        if "name" in e:
            d["name"] = e["name"]
        if "source" in e:
            d["source"] = e["source"]
        return d

    def head_to_json(e):
        d = {
            "slot": fmt_hex(e["slot"], 2),
            "headnum": fmt_hex(e["headnum"], 4),
            "requirefeature": fmt_hex(e["requirefeature"], 2),
        }
        if "source" in e:
            d["source"] = e["source"]
        return d

    def body_to_json(e):
        d = {
            "slot": fmt_hex(e["slot"], 2),
            "bodynum": fmt_hex(e["bodynum"], 4),
            "name": fmt_hex(e["name"], 4),
            "headnum": fmt_hex(e["headnum"], 4) if e["headnum"] != 1000 else "0x03e8",
            "requirefeature": fmt_hex(e["requirefeature"], 2),
        }
        if "source" in e:
            d["source"] = e["source"]
        return d

    output = {
        "headsAndBodies": [hab_to_json(e) for e in hab],
        "mpHeads": [head_to_json(e) for e in mp_heads],
        "mpBodies": [body_to_json(e) for e in mp_bodies],
    }

    with open(output_path, 'w') as f:
        json.dump(output, f, indent=2)

    print(f"Written {output_path}")
    print(f"  headsAndBodies: {len(hab)}")
    print(f"  mpHeads: {len(mp_heads)}")
    print(f"  mpBodies: {len(mp_bodies)}")


# ─── Step 10: Write binary .dat ─────────────────────────────────────────────

def write_dat(hab, mp_heads, mp_bodies, output_path):
    """
    Write mpHeadsAndBodiesTable.dat.

    Header:
        4 bytes: magic "MPHB"
        u32: version
        u32: numHeadsAndBodies
        u32: numMpHeads
        u32: numMpBodies
        u32: offsetHeadsAndBodies
        u32: offsetMpHeads
        u32: offsetMpBodies

    HeadsAndBodies entry (24 bytes):
        u16: flags (ismale:1 | hasownhead:1 | canvaryheight:1 | type:3 | height:8 | pad:2)
        u16: padding
        u32: filenum
        f32: scale
        f32: animscale
        u32: handfilenum
        s32: yoffset

    MpHead entry (4 bytes):
        s16: headnum
        u8:  requirefeature
        u8:  padding

    MpBody entry (8 bytes):
        s16: bodynum
        s16: name
        s16: headnum
        u8:  requirefeature
        u8:  padding
    """

    HEADER_SIZE = 4 + (7 * 4)  # magic + 7 u32s
    HAB_ENTRY_SIZE = 24
    MPHEAD_ENTRY_SIZE = 4
    MPBODY_ENTRY_SIZE = 8

    offset_hab = HEADER_SIZE
    offset_mp_heads = offset_hab + len(hab) * HAB_ENTRY_SIZE
    offset_mp_bodies = offset_mp_heads + len(mp_heads) * MPHEAD_ENTRY_SIZE

    buf = bytearray()

    # Header
    buf += MAGIC
    buf += struct.pack('<I', VERSION)
    buf += struct.pack('<I', len(hab))
    buf += struct.pack('<I', len(mp_heads))
    buf += struct.pack('<I', len(mp_bodies))
    buf += struct.pack('<I', offset_hab)
    buf += struct.pack('<I', offset_mp_heads)
    buf += struct.pack('<I', offset_mp_bodies)

    # HeadsAndBodies
    for e in hab:
        flags = 0
        flags |= (e["ismale"] & 1)
        flags |= (e["hasownhead"] & 1) << 1
        flags |= (e["canvaryheight"] & 1) << 2
        flags |= (e["type"] & 0x7) << 3
        flags |= (e["height"] & 0xFF) << 6
        # bits 14-15 unused (pad)

        buf += struct.pack('<H', flags & 0xFFFF)
        buf += struct.pack('<H', 0)  # padding
        buf += struct.pack('<I', e["filenum"])
        buf += struct.pack('<f', e["scale"])
        buf += struct.pack('<f', e["animscale"])
        buf += struct.pack('<I', e["handfilenum"])
        buf += struct.pack('<i', e["yoffset"])

    # MpHeads
    for e in mp_heads:
        buf += struct.pack('<h', e["headnum"])
        buf += struct.pack('<B', e["requirefeature"])
        buf += struct.pack('<B', 0)  # padding

    # MpBodies
    for e in mp_bodies:
        buf += struct.pack('<h', e["bodynum"])
        buf += struct.pack('<h', e["name"])
        buf += struct.pack('<h', e["headnum"])
        buf += struct.pack('<B', e["requirefeature"])
        buf += struct.pack('<B', 0)  # padding

    with open(output_path, 'wb') as f:
        f.write(buf)

    print(f"Written {output_path} ({len(buf)} bytes)")


# ─── Main ──────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="Build mpHeadsAndBodiesTable from vanilla source + mod modconfig.txt files",
        epilog="""

Examples:
  merge-heads --pd-src /path/to/pd-modloader
  merge-heads --pd-src . --mod-order mod_fojo,mod_gex
        """,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--pd-src", default=None,
                        help="Path to pd-modloader source root (default: cwd)")
    parser.add_argument("--filetable", default=None,
                        help="Path to merged filetable.json (default: <pd-src>/filetable.json)")
    parser.add_argument("--mods-root", default=None,
                        help="Path to mods directory containing mod_fojo/, mod_gex/, etc. (default: <pd-src>/mods)")
    parser.add_argument("--mod-order", default=None,
                        help="Comma-separated list of mod names to include (default: auto-detect from mods-root)")
    parser.add_argument("--output", default=None,
                        help="Output directory for .json and .dat files (default: cwd)")

    args = parser.parse_args()

    # Resolve --pd-src (workspace root)
    pd_src = os.path.expanduser(args.pd_src) if args.pd_src else os.getcwd()

    # All defaults are workspace-relative; no PD_BASEDIR autodetection.
    if args.mods_root:
        mods_dir = os.path.expanduser(args.mods_root)
    else:
        mods_dir = os.path.join(pd_src, "mods")

    if args.filetable:
        filetable_path = os.path.expanduser(args.filetable)
    else:
        filetable_path = os.path.join(pd_src, "filetable.json")

    if args.output:
        output_dir = os.path.expanduser(args.output)
    else:
        output_dir = os.getcwd()

    # Resolve --mod-order
    if args.mod_order:
        mod_names = [m.strip() for m in args.mod_order.split(',')]
    else:
        mod_names = None  # auto-detect later

    # Paths
    files_h = os.path.join(pd_src, "src", "include", "files.h")
    constants_h = os.path.join(pd_src, "src", "include", "constants.h")
    robot_c = os.path.join(pd_src, "src", "game", "modeldata", "robot.c")
    mplayer_c = os.path.join(pd_src, "src", "game", "mplayer", "mplayer.c")
    mod_c = os.path.join(pd_src, "port", "src", "mod.c")
    build_dir = os.path.join(pd_src, "build")

    print(f"pd-src:     {pd_src}")
    print(f"filetable:  {filetable_path}")
    print(f"mods-root:  {mods_dir}")
    print(f"output:     {output_dir}")

    # Validate
    for p in [files_h, constants_h, robot_c, mplayer_c, mod_c]:
        if not os.path.isfile(p):
            print(f"Error: {p} not found", file=sys.stderr)
            sys.exit(1)
    if not os.path.isfile(filetable_path):
        print(f"Error: {filetable_path} not found", file=sys.stderr)
        sys.exit(1)
    if not os.path.isdir(mods_dir):
        print(f"Error: {mods_dir} not found", file=sys.stderr)
        sys.exit(1)

    os.makedirs(output_dir, exist_ok=True)

    # 1. Parse constants
    print("Parsing FILE_ constants...")
    file_defines = parse_defines(files_h, ["FILE_"])

    print("Parsing HEAD_/BODY_/HEADBODYTYPE_/MPFEATURE_ constants...")
    const_defines = parse_defines(constants_h, ["HEAD_", "BODY_", "HEADBODYTYPE_", "MPFEATURE_"])

    # Merge FILE_ into const_defines for convenience
    all_defines = {**const_defines, **file_defines}

    # Parse generated lang enums
    print("Parsing generated lang enums...")
    lang_defines = {}
    if os.path.isdir(build_dir):
        lang_defines = parse_generated_lang_enums(build_dir)
        print(f"  Found {len(lang_defines)} lang values")
    else:
        print(f"  Warning: build dir {build_dir} not found, lang values will be 0")

    # 2. Parse vanilla tables
    print("Parsing vanilla g_HeadsAndBodiesOriginal...")
    vanilla_hab = parse_vanilla_heads_and_bodies(robot_c, all_defines, const_defines)
    print(f"  {len(vanilla_hab)} entries")

    print("Parsing vanilla g_MpHeadsOriginal...")
    vanilla_mp_heads = parse_vanilla_mp_heads(mplayer_c, const_defines)
    print(f"  {len(vanilla_mp_heads)} entries")

    print("Parsing vanilla g_MpBodiesOriginal...")
    vanilla_mp_bodies = parse_vanilla_mp_bodies(mplayer_c, const_defines, lang_defines)
    print(f"  {len(vanilla_mp_bodies)} entries")

    # 3. Parse vanilla head names
    print("Parsing vanilla head name registry...")
    vanilla_head_names_raw = parse_vanilla_head_names(mod_c)
    print(f"  {len(vanilla_head_names_raw)} name mappings")

    # 4. Load filetable (with vanilla FILE_ defines as fallback)
    vanilla_file_map = build_vanilla_filename_map(file_defines)
    print(f"  {len(vanilla_file_map)} vanilla file names derived from FILE_ defines")

    print(f"Loading filetable from {filetable_path}...")
    filetable_names = load_filetable(filetable_path, vanilla_file_map)
    print(f"  {len(filetable_names)} total file names")

    # 5. Scan mods
    if mod_names is None:
        # Auto-detect: all directories in mods_dir that contain modconfig.txt
        mod_names = []
        if os.path.isdir(mods_dir):
            for entry in sorted(os.listdir(mods_dir)):
                mod_path = os.path.join(mods_dir, entry)
                if os.path.isdir(mod_path) and os.path.isfile(os.path.join(mod_path, "modconfig.txt")):
                    mod_names.append(entry)

    print(f"Mods to process: {mod_names}")

    mod_entries_by_mod = {}
    for mod_name in mod_names:
        modconfig_path = os.path.join(mods_dir, mod_name, "modconfig.txt")
        if not os.path.isfile(modconfig_path):
            print(f"  Warning: {modconfig_path} not found, skipping")
            continue
        print(f"Parsing {mod_name}/modconfig.txt...")
        entries = parse_modconfig_heads_and_bodies(modconfig_path, filetable_names)
        if entries:
            mod_entries_by_mod[mod_name] = entries
            print(f"  {len(entries)} HeadsAndBodies entries")

    # 6. Merge
    print("Merging tables...")
    hab, mp_heads, mp_bodies = merge_tables(
        vanilla_hab, vanilla_mp_heads, vanilla_mp_bodies,
        vanilla_head_names_raw, const_defines, mod_entries_by_mod,
        filetable_names,
    )

    # 7. Write outputs
    json_path = os.path.join(output_dir, "mpHeadsAndBodiesTable.json")
    dat_path = os.path.join(output_dir, "mpHeadsAndBodiesTable.dat")

    write_json(hab, mp_heads, mp_bodies, json_path)
    write_dat(hab, mp_heads, mp_bodies, dat_path)


    print("\nDone!")


if __name__ == "__main__":
    main()
