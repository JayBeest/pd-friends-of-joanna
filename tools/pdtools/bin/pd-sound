#!/usr/bin/env php
<?php

// $PD = $_ENV['PD'];
$PD = getenv('PD');
// $PDTOOLS = $_ENV['PDTOOLS'];
$PDTOOLS = getenv('PDTOOLS');
// $ROMID = $_ENV['ROMID'] ?? 'ntsc-final';
$ROMID = getenv('ROMID') ?? 'ntsc-final';

$id = hexdec($argv[1]);

if ($id & 0x8000) {
	$id = resolve_russ($id);
}

if ($id & 0x1800) {
	do_mp3($id);
} else {
	do_instr($id);
}

