function do_instr($id)
{
	global $PDTOOLS;

	$name = sprintf('INSTR_0000_SND_%04X.wav', ($id & 0x7ff) - 1);

	// These wav files are expected to have been placed here by a separate sound ripper tool
	echo $name . "\n";
	`mpv --speed=0.25 --audio-pitch-correction=no "$PDTOOLS/tmp/wav/$name"`;
}

function do_mp3($id)
{
	global $PD;
	global $ROMID;

	$header = file_get_contents("$PD/src/include/files.h");

	$id = $id & 0x07ff;
	preg_match('/FILE_A(\S+)M\s+0x' . sprintf('%04x', $id) . '/', $header, $match);
	$name = 'A' . strtolower($match[1]) . 'M';

	echo $name . "\n";
	`mpv "$PD/extracted/$ROMID/files/$name"`;
}
